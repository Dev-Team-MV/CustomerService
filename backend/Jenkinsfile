// Jenkinsfile para CustomerService - backend
// Jobs en Jenkins: CustomerService-Backend-Develop (BD Atlas dev) | CustomerService-Backend-Production (BD VPS pdn)
// Develop → apicsdev.michelangelodelvalle.com:5001 | Production → apics.michelangelodelvalle.com:5000
//
// Acceptance (Karate):
//   Develop  → post-deploy suite amplia (~@external) vía red Docker deploy_app-network; fallo → rollback
//   Production → pre-deploy: Mongo aislado + seed + API temporal en acceptance-net; si falla → NO Deploy pdn
// Requisitos agente: Docker, docker compose (JDK no requerido: Karate corre en contenedor Maven)
// Health check usa docker exec (Jenkins-in-Docker no ve localhost:hostPort)
// Credenciales opcionales: karate-acceptance-admin | env KARATE_ADMIN_* / KARATE_PROJECT_ID
//
// IMPORTANTE: Solo se ejecuta si hay cambios en backend/.

pipeline {
    agent any

    environment {
        APP_DIR = 'backend'
        JWT_SECRET = 'supersecretkey123456789'
        UPLOAD_MAX_FILE_SIZE_MB = '1024'
        CORS_ORIGINS = 'https://devlakewoodp1.michelangelodelvalle.com,https://lakewoodp1.michelangelodelvalle.com,https://devlakewoodp2.michelangelodelvalle.com,https://lakewoodp2.michelangelodelvalle.com,https://devcrm.michelangelodelvalle.com,https://crm.michelangelodelvalle.com,https://dev6town.michelangelodelvalle.com,https://6towncsdev.michelangelodelvalle.com,https://6town.michelangelodelvalle.com,https://6towncs.michelangelodelvalle.com,https://lakewoodoaksonlakeconroe.com,https://www.lakewoodoaksonlakeconroe.com'
        TWILIO_PHONE_FROM = '+18327707897'
        GCS_PROJECT_ID = 'centurions-car-wash-442201'
        GCS_BUCKET_NAME = 'customer-service-7cc'
        GCS_MAKE_PUBLIC = 'false'
        ACCEPTANCE_PORT = '15001'
        ACCEPTANCE_CONTAINER = 'backend-acceptance'
        ACCEPTANCE_MONGO_PORT = '27018'
        LAST_GOOD_TAG_SUFFIX = 'last-good'
        KARATE_TAGS = '--tags ~@external'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check changes') {
            steps {
                script {
                    env.SHOULD_RUN = 'false'
                    def changed = sh(script: """
                        if [ -n \"${env.GIT_PREVIOUS_COMMIT ?: ''}\" ] && [ \"${env.GIT_PREVIOUS_COMMIT}\" != \"${env.GIT_COMMIT ?: ''}\" ]; then
                            git diff --name-only \"${env.GIT_PREVIOUS_COMMIT}\" \"${env.GIT_COMMIT}\" 2>/dev/null || true
                        else
                            (git rev-parse --quiet --verify HEAD~1 >/dev/null 2>&1 && git diff --name-only HEAD~1 HEAD) || echo 'backend/'
                        fi
                    """, returnStdout: true).trim()
                    def hasBackendChanges = changed.split('\n').findAll { it.trim() }.any { it.startsWith('backend/') }
                    env.SHOULD_RUN = hasBackendChanges ? 'true' : 'false'
                    echo "Changed files: ${changed.replace('\n', ', ')}"
                    echo "SHOULD_RUN (backend): ${env.SHOULD_RUN}"
                    if (env.SHOULD_RUN == 'false') {
                        currentBuild.description = 'Skipped (no backend changes)'
                    }
                }
            }
        }

        stage('Set environment') {
            when { expression { env.SHOULD_RUN == 'true' } }
            steps {
                script {
                    def branch = env.BRANCH_NAME ?: env.GIT_BRANCH?.replaceFirst('^origin/', '') ?: 'develop'
                    def jobName = (env.JOB_NAME ?: '').toLowerCase()
                    def isProdJob = jobName.contains('production') || jobName.contains('prod') || jobName.contains('pdn')
                    def isDevJob = jobName.contains('development') || jobName.contains('dev')
                    if (isDevJob && branch != 'develop') {
                        error "Job Develop solo debe ejecutarse con rama 'develop'. Rama actual: ${branch}."
                    }
                    if (isProdJob && branch != 'main' && branch != 'master') {
                        error "Job Production solo debe ejecutarse con rama 'main' (o 'master'). Rama actual: ${branch}."
                    }
                    if (isDevJob) {
                        env.IS_PRODUCTION = 'false'
                    } else if (isProdJob) {
                        env.IS_PRODUCTION = 'true'
                    } else {
                        env.IS_PRODUCTION = (env.DEPLOY_ENV == 'production' || branch == 'main').toString()
                    }
                    env.ENVIRONMENT = (env.IS_PRODUCTION == 'true') ? 'production' : 'development'
                    env.CONTAINER_NAME = (env.IS_PRODUCTION == 'true') ? 'backend' : 'backend-dev'
                    env.APP_PORT = (env.IS_PRODUCTION == 'true') ? '5000' : '5001'
                    env.IMAGE_NAME = 'customerservice-backend'
                    env.IMAGE_TAG = "${env.ENVIRONMENT}-${env.BUILD_NUMBER}"
                    env.LAST_GOOD_IMAGE = "${env.IMAGE_NAME}:${env.ENVIRONMENT}-${env.LAST_GOOD_TAG_SUFFIX}"
                    env.PUBLIC_URL = (env.IS_PRODUCTION == 'true') ? 'https://apics.michelangelodelvalle.com' : 'https://apicsdev.michelangelodelvalle.com'
                    def fe = (env.FRONTEND_URL ?: '').trim()
                    if (!fe) {
                        def jn = (env.JOB_NAME ?: '').toLowerCase()
                        def prod = env.IS_PRODUCTION == 'true'
                        if (jn.contains('mvcrm') || jn.contains('mv-crm') || jn.contains('mv_crm')) {
                            fe = prod ? 'https://crm.michelangelodelvalle.com' : 'https://devcrm.michelangelodelvalle.com'
                        } else if (jn.contains('phase2') || jn.contains('phase-2') || jn.contains('fase2')
                                || jn.contains('lakewoodp2') || jn.contains('lakewood-p2')) {
                            fe = prod ? 'https://lakewoodp2.michelangelodelvalle.com' : 'https://devlakewoodp2.michelangelodelvalle.com'
                        } else {
                            fe = prod ? 'https://lakewoodp1.michelangelodelvalle.com' : 'https://devlakewoodp1.michelangelodelvalle.com'
                        }
                    }
                    env.FRONTEND_URL = fe
                    def uriPdn = 'mongodb://mongo_customerservice:WmSld1ZrUWzWcaDZ6QBKl7QDKQsMnPfp@72.61.6.13:27017/customerservice?authSource=admin'
                    def uriDev = 'mongodb+srv://customerservicemichelangelo_db_user:lRNMjO5qLRGD6csL@customerservice.mkutnlt.mongodb.net/customerservice'
                    env.MONGODB_URI_DEV = uriDev
                    env.MONGODB_URI = (env.IS_PRODUCTION == 'true') ? uriPdn : uriDev
                    if (!(env.KARATE_ADMIN_EMAIL ?: '').trim()) {
                        env.KARATE_ADMIN_EMAIL = 'superadmin@lakewood.com'
                    }
                    if (!(env.KARATE_ADMIN_PASSWORD ?: '').trim()) {
                        env.KARATE_ADMIN_PASSWORD = 'admin123'
                    }
                    if (!(env.KARATE_PROJECT_ID ?: '').trim()) {
                        env.KARATE_PROJECT_ID = '69a73ce5b20401b061da6451'
                    }
                    echo "========== CONFIGURACIÓN BACKEND =========="
                    echo "Job: ${env.JOB_NAME} | Rama: ${branch} | IS_PRODUCTION: ${env.IS_PRODUCTION}"
                    echo "Contenedor: ${env.CONTAINER_NAME} | Puerto: ${env.APP_PORT}"
                    echo "Imagen: ${env.IMAGE_NAME}:${env.IMAGE_TAG} | last-good: ${env.LAST_GOOD_IMAGE}"
                    echo "Karate: ${env.KARATE_ADMIN_EMAIL} | projectId: ${env.KARATE_PROJECT_ID} | tags: ${env.KARATE_TAGS}"
                    echo "==========================================="
                }
            }
        }

        stage('Install') {
            when { expression { env.SHOULD_RUN == 'true' } }
            steps {
                dir(env.APP_DIR) {
                    sh '''#!/bin/bash
                        set -e
                        mkdir -p "${WORKSPACE}/.nvm"
                        export NVM_DIR="${WORKSPACE}/.nvm"
                        curl -sSf -o- https://raw.githubusercontent.com/nvm-sh/nvm/v0.40.1/install.sh | bash
                        [ -s "$NVM_DIR/nvm.sh" ] && \\. "$NVM_DIR/nvm.sh"
                        nvm install 20
                        nvm use 20
                        npm ci
                    '''
                }
            }
        }

        stage('Build Docker') {
            when { expression { env.SHOULD_RUN == 'true' } }
            steps {
                dir(env.APP_DIR) {
                    sh "docker build -t ${env.IMAGE_NAME}:${env.IMAGE_TAG} ."
                }
            }
        }

        // Production: Mongo aislado + seed + API temporal → Karate wide; no toca pdn
        stage('Acceptance gate (pre-deploy)') {
            when {
                allOf {
                    expression { env.SHOULD_RUN == 'true' }
                    expression { env.IS_PRODUCTION == 'true' }
                }
            }
            steps {
                script {
                    try {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'karate-acceptance-admin',
                                usernameVariable: 'KARATE_CRED_EMAIL',
                                passwordVariable: 'KARATE_CRED_PASSWORD'
                            )
                        ]) {
                            env.KARATE_ADMIN_EMAIL = env.KARATE_CRED_EMAIL
                            env.KARATE_ADMIN_PASSWORD = env.KARATE_CRED_PASSWORD
                        }
                    } catch (ignored) {
                        echo "Credential 'karate-acceptance-admin' not found; using defaults."
                    }

                    sh '''#!/bin/bash
                        set -e
                        chmod +x backend/karate-tests/scripts/*.sh
                        export IMAGE_NAME="${IMAGE_NAME}"
                        export IMAGE_TAG="${IMAGE_TAG}"
                        export ACCEPTANCE_PORT="${ACCEPTANCE_PORT}"
                        export ACCEPTANCE_MONGO_PORT="${ACCEPTANCE_MONGO_PORT}"
                        export ACCEPTANCE_CONTAINER="${ACCEPTANCE_CONTAINER}"
                        export JWT_SECRET="${JWT_SECRET}"
                        export FRONTEND_URL="${FRONTEND_URL}"
                        export PUBLIC_URL="${PUBLIC_URL}"
                        export KARATE_ADMIN_EMAIL="${KARATE_ADMIN_EMAIL}"
                        export KARATE_ADMIN_PASSWORD="${KARATE_ADMIN_PASSWORD}"
                        backend/karate-tests/scripts/start-acceptance-stack.sh
                    '''

                    def envFile = readFile('backend/karate-tests/acceptance.env').trim()
                    envFile.split('\n').each { line ->
                        def parts = line.split('=', 2)
                        if (parts.length == 2) {
                            env."${parts[0]}" = parts[1]
                        }
                    }
                    echo "Gate baseUrl=${env.KARATE_BASE_URL} projectId=${env.KARATE_PROJECT_ID}"

                    sh '''#!/bin/bash
                        set -e
                        chmod +x backend/karate-tests/scripts/*.sh
                        export DOCKER_NETWORK="${KARATE_DOCKER_NETWORK:-acceptance-net}"
                        export BASE_URL="${KARATE_BASE_URL}"
                        export KARATE_ADMIN_EMAIL
                        export KARATE_ADMIN_PASSWORD
                        export KARATE_PROJECT_ID
                        export KARATE_TAGS
                        backend/karate-tests/scripts/run-karate.sh
                    '''
                }
            }
            post {
                always {
                    sh 'backend/karate-tests/scripts/stop-acceptance-stack.sh || true'
                    junit allowEmptyResults: true, testResults: 'backend/karate-tests/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'backend/karate-tests/target/karate-reports/**', allowEmptyArchive: true
                }
                failure {
                    script {
                        echo 'Acceptance gate FAILED — Production Deploy will NOT run.'
                        currentBuild.description = 'Blocked: Karate acceptance failed (no pdn deploy)'
                    }
                }
            }
        }

        stage('Deploy') {
            when { expression { env.SHOULD_RUN == 'true' } }
            steps {
                script {
                    // Develop: recordar imagen actual para rollback
                    if (env.IS_PRODUCTION != 'true') {
                        def running = sh(
                            script: "docker inspect -f '{{.Config.Image}}' ${env.CONTAINER_NAME} 2>/dev/null || true",
                            returnStdout: true
                        ).trim()
                        if (running) {
                            env.PREVIOUS_IMAGE = running
                        } else {
                            def hasLastGood = sh(
                                script: "docker image inspect ${env.LAST_GOOD_IMAGE} >/dev/null 2>&1 && echo yes || true",
                                returnStdout: true
                            ).trim()
                            env.PREVIOUS_IMAGE = (hasLastGood == 'yes') ? env.LAST_GOOD_IMAGE : ''
                        }
                        echo "Rollback candidate image: ${env.PREVIOUS_IMAGE ?: '(none)'}"
                    }

                    withCredentials([
                        string(credentialsId: 'twilio-account-sid', variable: 'TWILIO_ACCOUNT_SID'),
                        string(credentialsId: 'twilio-auth-token', variable: 'TWILIO_AUTH_TOKEN'),
                        string(credentialsId: 'gcs-credentials-json', variable: 'GCS_CREDENTIALS')
                    ]) {
                        sh "docker rm -f ${env.CONTAINER_NAME} 2>/dev/null || true"
                        sh '''
                            printf 'GCS_CREDENTIALS=%s\\n' "$GCS_CREDENTIALS" > "${WORKSPACE}/backend/gcs.env"
                            docker run -d \
                              --name ''' + env.CONTAINER_NAME + ''' \
                              --network deploy_app-network \
                              -p ''' + env.APP_PORT + ''':5000 \
                              -e NODE_ENV=''' + (env.IS_PRODUCTION == 'true' ? 'production' : 'development') + ''' \
                              -e PORT=5000 \
                              -e PUBLIC_URL=''' + env.PUBLIC_URL + ''' \
                              -e FRONTEND_URL=''' + env.FRONTEND_URL + ''' \
                              -e UPLOAD_MAX_FILE_SIZE_MB=''' + env.UPLOAD_MAX_FILE_SIZE_MB + ''' \
                              -e CORS_ORIGINS=''' + env.CORS_ORIGINS + ''' \
                              -e MONGODB_URI="$MONGODB_URI" \
                              -e JWT_SECRET=''' + env.JWT_SECRET + ''' \
                              -e TWILIO_ACCOUNT_SID=$TWILIO_ACCOUNT_SID \
                              -e TWILIO_AUTH_TOKEN=$TWILIO_AUTH_TOKEN \
                              -e TWILIO_PHONE_FROM=''' + env.TWILIO_PHONE_FROM + ''' \
                              -e GCS_PROJECT_ID=''' + env.GCS_PROJECT_ID + ''' \
                              -e GCS_BUCKET_NAME=''' + env.GCS_BUCKET_NAME + ''' \
                              -e GCS_MAKE_PUBLIC=''' + env.GCS_MAKE_PUBLIC + ''' \
                              --env-file "${WORKSPACE}/backend/gcs.env" \
                              --restart unless-stopped \
                              ''' + env.IMAGE_NAME + ':' + env.IMAGE_TAG + '''
                        '''
                    }
                }
            }
        }

        stage('Wait health') {
            when {
                allOf {
                    expression { env.SHOULD_RUN == 'true' }
                    expression { env.IS_PRODUCTION != 'true' }
                }
            }
            steps {
                sh '''#!/bin/bash
                    set -e
                    echo "Waiting for /api/health inside container ${CONTAINER_NAME}..."
                    # Jenkins suele correr en Docker: localhost:APP_PORT no alcanza el puerto publicado en el host.
                    for i in $(seq 1 40); do
                      if docker exec "${CONTAINER_NAME}" node -e "fetch('http://127.0.0.1:5000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))" 2>/dev/null; then
                        echo "Health OK (attempt ${i})"
                        exit 0
                      fi
                      sleep 3
                    done
                    echo "Deployed container failed health check"
                    docker logs "${CONTAINER_NAME}" || true
                    exit 1
                '''
            }
            post {
                failure {
                    script { rollbackDevelopIfPossible() }
                }
            }
        }

        stage('Acceptance (Karate)') {
            when {
                allOf {
                    expression { env.SHOULD_RUN == 'true' }
                    expression { env.IS_PRODUCTION != 'true' }
                }
            }
            steps {
                script {
                    try {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'karate-acceptance-admin',
                                usernameVariable: 'KARATE_CRED_EMAIL',
                                passwordVariable: 'KARATE_CRED_PASSWORD'
                            )
                        ]) {
                            env.KARATE_ADMIN_EMAIL = env.KARATE_CRED_EMAIL
                            env.KARATE_ADMIN_PASSWORD = env.KARATE_CRED_PASSWORD
                        }
                    } catch (ignored) {
                        echo "Credential 'karate-acceptance-admin' not found; using defaults."
                    }

                    sh '''#!/bin/bash
                        set -e
                        chmod +x backend/karate-tests/scripts/*.sh
                        export DOCKER_NETWORK=deploy_app-network
                        export BASE_URL="http://${CONTAINER_NAME}:5000"
                        export KARATE_ADMIN_EMAIL
                        export KARATE_ADMIN_PASSWORD
                        export KARATE_PROJECT_ID
                        export KARATE_TAGS
                        backend/karate-tests/scripts/run-karate.sh
                    '''

                    // Marcar esta imagen como last-good tras suite OK
                    sh "docker tag ${env.IMAGE_NAME}:${env.IMAGE_TAG} ${env.LAST_GOOD_IMAGE}"
                    echo "Tagged ${env.LAST_GOOD_IMAGE}"
                }
            }
            post {
                always {
                    junit allowEmptyResults: true, testResults: 'backend/karate-tests/target/surefire-reports/*.xml'
                    archiveArtifacts artifacts: 'backend/karate-tests/target/karate-reports/**', allowEmptyArchive: true
                }
                failure {
                    script { rollbackDevelopIfPossible() }
                }
            }
        }
    }

    post {
        success {
            echo "========== DESPLIEGUE OK =========="
            echo "Ambiente: ${env.ENVIRONMENT} | Contenedor: ${env.CONTAINER_NAME} | Puerto: ${env.APP_PORT}"
            echo "URL local: http://localhost:${env.APP_PORT}"
            echo "===================================="
        }
        failure {
            script {
                echo 'Falló el pipeline'
                if (env.IS_PRODUCTION == 'true') {
                    echo 'Si falló Acceptance gate (pre-deploy), pdn NO fue actualizado.'
                } else {
                    echo 'Si falló health/Karate en Develop, se intentó rollback automático.'
                }
            }
        }
    }
}

def rollbackDevelopIfPossible() {
    if (env.IS_PRODUCTION == 'true') {
        return
    }
    def prev = (env.PREVIOUS_IMAGE ?: '').trim()
    if (!prev) {
        echo 'Rollback skipped: no previous image available'
        currentBuild.description = 'Acceptance failed (no rollback image)'
        return
    }
    echo "Rolling back Develop to ${prev}..."
    try {
        withCredentials([
            string(credentialsId: 'twilio-account-sid', variable: 'TWILIO_ACCOUNT_SID'),
            string(credentialsId: 'twilio-auth-token', variable: 'TWILIO_AUTH_TOKEN'),
            string(credentialsId: 'gcs-credentials-json', variable: 'GCS_CREDENTIALS')
        ]) {
            sh "docker rm -f ${env.CONTAINER_NAME} 2>/dev/null || true"
            sh '''
                printf 'GCS_CREDENTIALS=%s\\n' "$GCS_CREDENTIALS" > "${WORKSPACE}/backend/gcs.env"
                docker run -d \
                  --name ''' + env.CONTAINER_NAME + ''' \
                  --network deploy_app-network \
                  -p ''' + env.APP_PORT + ''':5000 \
                  -e NODE_ENV=development \
                  -e PORT=5000 \
                  -e PUBLIC_URL=''' + env.PUBLIC_URL + ''' \
                  -e FRONTEND_URL=''' + env.FRONTEND_URL + ''' \
                  -e UPLOAD_MAX_FILE_SIZE_MB=''' + env.UPLOAD_MAX_FILE_SIZE_MB + ''' \
                  -e CORS_ORIGINS=''' + env.CORS_ORIGINS + ''' \
                  -e MONGODB_URI="$MONGODB_URI" \
                  -e JWT_SECRET=''' + env.JWT_SECRET + ''' \
                  -e TWILIO_ACCOUNT_SID=$TWILIO_ACCOUNT_SID \
                  -e TWILIO_AUTH_TOKEN=$TWILIO_AUTH_TOKEN \
                  -e TWILIO_PHONE_FROM=''' + env.TWILIO_PHONE_FROM + ''' \
                  -e GCS_PROJECT_ID=''' + env.GCS_PROJECT_ID + ''' \
                  -e GCS_BUCKET_NAME=''' + env.GCS_BUCKET_NAME + ''' \
                  -e GCS_MAKE_PUBLIC=''' + env.GCS_MAKE_PUBLIC + ''' \
                  --env-file "${WORKSPACE}/backend/gcs.env" \
                  --restart unless-stopped \
                  ''' + prev + '''
            '''
        }
        currentBuild.description = "Rolled back to ${prev}"
        echo "Rollback OK → ${prev}"
    } catch (Exception e) {
        echo "Rollback FAILED: ${e}"
        currentBuild.description = "Acceptance failed; rollback also failed"
    }
}
